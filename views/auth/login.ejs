<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <title>Log in — LearnLoop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Lusion Aesthetic: Cursor & Canvas -->
  <div class="cursor-dot"></div>
  <div class="cursor-outline"></div>
  
  <div class="auth-wrapper">
    <div class="auth-panel-left">
      <canvas id="canvas-bg"></canvas>
      <div class="brand"><span class="brand-mark"></span>LearnLoop</div>
      <h2>Your streak is waiting.</h2>
      <p>Every day you log and revise, the forgetting curve gets a little flatter.</p>
    </div>
    <div class="auth-panel-right">
      <div class="auth-card rise-in">
        <h1>Welcome back</h1>
        <p class="subtitle">Log in to keep your streak going.</p>

        <% if (error) { %>
          <div class="error-banner"><%= error %></div>
        <% } %>

        <form action="/auth/login" method="POST">
          <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required autofocus>
          </div>
          <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
          </div>
          <button type="submit" class="btn btn-primary btn-full magnetic">Log in</button>
        </form>

        <p class="auth-footer">
          Don't have an account? <a href="/auth/register">Register</a>
        </p>
      </div>
    </div>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/cursor.js"></script>
  <script src="/js/canvas-bg.js"></script>
</body>
</html>
