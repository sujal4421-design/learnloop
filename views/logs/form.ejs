<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <title><%= mode === 'create' ? 'Add Log' : 'Edit Log' %> — LearnLoop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="cursor-dot"></div>
  <div class="cursor-outline"></div>
  <canvas id="canvas-bg" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none;"></canvas>
  <%- include('../partials/nav') %>

  <div class="page" style="max-width:520px;">
    <div class="page-header rise-in rise-in-1">
      <h1 style="font-size:22px;"><%= mode === 'create' ? 'Log what you learned today' : 'Edit log' %></h1>
    </div>

    <% if (error) { %>
      <div class="error-banner"><%= error %></div>
    <% } %>

    <form action="<%= mode === 'create' ? '/logs' : '/logs/' + log.id %>" method="POST"
          class="card spotlight rise-in rise-in-2"
          style="padding:24px;<% if (mode === 'edit') { %> view-transition-name: log-card-<%= log.id %>;<% } %>">
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" placeholder="e.g. Array Methods in JS"
               value="<%= log ? log.title : '' %>" required autofocus>
      </div>
      <div class="form-group">
        <label for="category">Category</label>
        <input type="text" id="category" name="category" placeholder="e.g. DSA, Web Dev, Database"
               value="<%= log ? log.category : '' %>" required>
      </div>
      <div class="form-group" style="margin-bottom:20px;">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" placeholder="e.g. Learned map, filter, reduce" required><%= log ? log.description : '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-full magnetic"><%= mode === 'create' ? 'Save log' : 'Update log' %></button>
    </form>

    <p class="auth-footer"><a href="/dashboard#logs" class="magnetic" style="display:inline-block;">← Back to my logs</a></p>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/cursor.js"></script>
  <script src="/js/canvas-bg.js"></script>
</body>
</html>
