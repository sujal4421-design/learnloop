<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= mode === 'create' ? 'Add Log' : 'Edit Log' %> — LearnLoop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/nav') %>

  <div style="max-width: 520px; margin: 40px auto; padding: 0 24px;">
    <h1 style="font-size:22px; margin-bottom:24px;">
      <%= mode === 'create' ? 'Log what you learned today' : 'Edit log' %>
    </h1>

    <% if (error) { %>
      <div class="error-banner"><%= error %></div>
    <% } %>

    <form action="<%= mode === 'create' ? '/logs' : '/logs/' + log.id %>" method="POST">
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" placeholder="e.g. Array Methods in JS"
               value="<%= log ? log.title : '' %>" required autofocus>
      </div>
      <div class="form-group">
        <label for="category">Category</label>
        <input type="text" id="category" name="category" placeholder="e.g. DSA, Web Dev, Database"
               value="<%= log ? log.category : '' %>" required>
      </div>
      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" placeholder="e.g. Learned map, filter, reduce"
                  required style="width:100%; padding:10px 12px; border:1px solid var(--color-border); border-radius:var(--radius); font-family:inherit; font-size:14px; resize:vertical;"><%= log ? log.description : '' %></textarea>
      </div>
      <button type="submit"><%= mode === 'create' ? 'Save log' : 'Update log' %></button>
    </form>

    <p class="auth-footer"><a href="/logs">← Back to my logs</a></p>
  </div>
</body>
</html>
