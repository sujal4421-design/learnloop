<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="view-transition" content="same-origin">
  <title>Dashboard — LearnLoop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="cursor-dot"></div>
  <div class="cursor-outline"></div>
  <canvas id="canvas-bg" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none;"></canvas>
  <%- include('partials/nav') %>

  <div class="page" id="page-container">
    
    <!-- SECTION 1: OVERVIEW -->
    <section id="overview" class="scroll-section">
      <div class="page-header rise-in rise-in-1">
        <h1>Welcome back, <%= userName %></h1>
        <p>Here's where your learning stands today.</p>
      </div>

      <% if (summary.dueTodayCount > 0) { %>
        <div class="notice-banner rise-in rise-in-2">
          <span style="display:flex; align-items:center; gap:8px;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            You have <strong><%= summary.dueTodayCount %></strong> topic<%= summary.dueTodayCount > 1 ? 's' : '' %> to revise today.
          </span>
          <a href="#revisions">Revise now →</a>
        </div>
      <% } %>

      <div class="bento-grid">
        <%
          const ringRadius = 42;
          const ringCirc = 2 * Math.PI * ringRadius;
          const ringGoal = 30;
          const ringPct = Math.min(summary.currentStreak / ringGoal, 1);
          const ringOffset = ringCirc * (1 - ringPct);
        %>
        <div class="card glass spotlight tilt bento-hero rise-in rise-in-1">
          <svg class="rings-bg" width="220" height="220" viewBox="0 0 220 220">
            <circle cx="160" cy="160" r="24" fill="none" stroke="white" stroke-width="1.5"></circle>
            <circle cx="160" cy="160" r="48" fill="none" stroke="white" stroke-width="1.5"></circle>
            <circle cx="160" cy="160" r="76" fill="none" stroke="white" stroke-width="1.5"></circle>
            <circle cx="160" cy="160" r="108" fill="none" stroke="white" stroke-width="1.5"></circle>
          </svg>
          <div>
            <div class="stat-label">Current Streak</div>
            <div style="font-size:13px; color:rgba(255,255,255,0.75);">Keep the chain going</div>
          </div>
          <div style="display:flex; align-items:center; gap:20px; margin-top:16px; position:relative; z-index:1;">
            <div class="streak-ring">
              <svg width="100" height="100" viewBox="0 0 100 100">
                <circle class="ring-track" cx="50" cy="50" r="<%= ringRadius %>"></circle>
                <circle class="ring-progress" cx="50" cy="50" r="<%= ringRadius %>" stroke-dasharray="<%= ringCirc %>" stroke-dashoffset="<%= ringOffset %>"></circle>
                <text x="50" y="58" text-anchor="middle" class="ring-center-value"><%= summary.currentStreak %></text>
              </svg>
            </div>
            <div>
              <div style="font-size:13px; color:rgba(255,255,255,0.75);">days in a row</div>
              <div style="font-size:13px; color:rgba(255,255,255,0.75); margin-top:4px;">Longest: <strong style="color:white;"><%= summary.longestStreak %></strong> days</div>
            </div>
          </div>
        </div>

        <div class="card card-hover tilt stat-card rise-in rise-in-2" onclick="document.getElementById('revisions').scrollIntoView({behavior: 'smooth'})" style="cursor:pointer;">
          <div class="icon-chip amber">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="stat-label">Due Today</div>
          <div class="stat-value"><%= summary.dueTodayCount %></div>
          <div class="stat-sub"><a href="#revisions">Revise now →</a></div>
        </div>

        <div class="card card-hover tilt stat-card rise-in rise-in-3" onclick="document.getElementById('logs').scrollIntoView({behavior: 'smooth'})" style="cursor:pointer;">
          <div class="icon-chip green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          </div>
          <div class="stat-label">Total Topics Logged</div>
          <div class="stat-value"><%= summary.totalLogs %></div>
          <div class="stat-sub"><a href="#logs">View all →</a></div>
        </div>

        <div class="card card-hover tilt stat-card rise-in rise-in-4">
          <div class="icon-chip green">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </div>
          <div class="stat-label">Revised vs Pending</div>
          <div class="stat-value"><%= summary.revisedCount %> <span style="color:var(--ink-muted); font-size:16px; font-family:var(--font-body);">/ <%= summary.revisedCount + summary.pendingCount %></span></div>
          <div class="stat-sub"><%= summary.pendingCount %> still pending</div>
        </div>
      </div>

      <!-- Heatmap Card -->
      <div class="card glass tilt rise-in rise-in-5" style="padding:24px; margin-top:20px;">
        <div class="section-title">Activity Heatmap</div>
        <% 
          // Create a map of dates to counts
          const activityMap = {};
          if (summary.heatmapData) {
            summary.heatmapData.forEach(d => { activityMap[d.date] = d.count; });
          }
          
          // Generate the last 91 days (13 weeks * 7 days)
          const days = [];
          for (let i = 90; i >= 0; i--) {
            const d = new Date();
            d.setDate(d.getDate() - i);
            // format local date as YYYY-MM-DD safely
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const dayStr = String(d.getDate()).padStart(2, '0');
            const dateStr = `${y}-${m}-${dayStr}`;
            days.push({ date: dateStr, count: activityMap[dateStr] || 0 });
          }
        %>
        <div class="heatmap-container">
          <% days.forEach(day => { 
               let level = 0;
               if (day.count === 1) level = 1;
               else if (day.count === 2) level = 2;
               else if (day.count >= 3) level = 3;
          %>
            <div class="heatmap-day level-<%= level %>" title="<%= day.count %> logs on <%= day.date %>"></div>
          <% }) %>
        </div>
        <div style="display:flex; justify-content:flex-end; align-items:center; gap:6px; font-size:12px; color:var(--ink-muted); margin-top:12px;">
          <span>Less</span>
          <div class="heatmap-day level-0"></div>
          <div class="heatmap-day level-1"></div>
          <div class="heatmap-day level-2"></div>
          <div class="heatmap-day level-3"></div>
          <span>More</span>
        </div>
      </div>

    </section>

    <!-- SECTION 2: LOGS -->
    <section id="logs" class="scroll-section">
      <div class="page-header" style="display:flex; justify-content:space-between; align-items:flex-end;">
        <div>
          <h1>My Learning Logs</h1>
          <p>Everything you've logged, in one place.</p>
        </div>
        <a href="/logs/new" class="btn btn-primary magnetic">+ Add Log</a>
      </div>

      <% if (logs.length === 0) { %>
        <div class="empty-state card">
          <p>You haven't logged anything yet.</p>
          <a href="/logs/new">Log your first topic →</a>
        </div>
      <% } else { %>
        <% logs.forEach((log, i) => { %>
          <div class="card card-hover spotlight tilt item-card" style="view-transition-name: log-card-<%= log.id %>; position:relative; cursor:pointer; margin-bottom:12px;">
            <a href="/logs/<%= log.id %>/edit" class="card-link" style="position:absolute; inset:0; z-index:1;"></a>
            <div class="item-card-inner">
              <div>
                <span class="badge"><%= log.category %></span>
                <h3 class="item-title"><%= log.title %></h3>
                <p class="item-desc"><%= log.description %></p>
                <% if (log.ai_summary) { %>
                  <p class="item-ai-summary"><span>✨</span><span class="typewriter"><%= log.ai_summary %></span></p>
                <% } %>
                <p class="item-meta">Logged on <%= new Date(log.date_learned).toLocaleDateString() %></p>
              </div>
              <div class="item-actions" style="position:relative; z-index:2;">
                <a href="/logs/<%= log.id %>/edit" style="view-transition-name: log-title-<%= log.id %>;">Edit</a>
                <form action="/logs/<%= log.id %>/delete" method="POST" onsubmit="return confirm('Delete this log? This cannot be undone.');">
                  <button type="submit" class="btn-text-danger" style="border:none; cursor:pointer; font-weight:600;">Delete</button>
                </form>
              </div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <!-- SECTION 3: REVISIONS -->
    <section id="revisions" class="scroll-section">
      <div class="page-header">
        <h1>What to revise today</h1>
        <p>Includes anything due today or overdue.</p>
      </div>

      <% if (dueRevisions.length === 0) { %>
        <div class="empty-state card">
          <p>Nothing due today — you're all caught up. 🎉</p>
          <a href="#logs">View my logs →</a>
        </div>
      <% } else { %>
        <% dueRevisions.forEach((rev, i) => { %>
          <div class="card card-hover spotlight item-card" style="margin-bottom:12px;">
            <div class="item-card-inner" style="align-items:center;">
              <div>
                <span class="badge"><%= rev.category %></span>
                <h3 class="item-title" style="font-size:15px; margin:6px 0 2px;"><%= rev.title %></h3>
                <p class="item-meta" style="margin:0;">Scheduled for <%= new Date(rev.scheduled_date).toLocaleDateString() %></p>
              </div>
              <form action="/revisions/<%= rev.id %>/complete" method="POST">
                <button type="submit" class="btn btn-primary btn-sm magnetic">Mark revised</button>
              </form>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

  </div>

  <!-- Search Overlay -->
  <div id="search-overlay" class="search-overlay" style="display:none;">
    <div class="search-modal">
      <div class="search-input-wrapper">
        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="search-input" placeholder="Search your logs... (Cmd+K)" autocomplete="off">
        <span class="search-esc">ESC</span>
      </div>
      <div id="search-results" class="search-results">
        <!-- Results cloned here via JS -->
      </div>
    </div>
  </div>

  <script src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/cursor.js"></script>
  <script src="/js/canvas-bg.js"></script>
  <script>
    // Initialize Lenis for premium, buttery-smooth scrolling
    const lenis = new Lenis({
      lerp: 0.08, // Slightly faster responsiveness, but still highly fluid
      wheelMultiplier: 1.0, // Normal distance per scroll click
      direction: 'vertical',
      gestureDirection: 'vertical',
      smooth: true,
      smoothTouch: false,
      touchMultiplier: 2,
    });

    function raf(time) {
      lenis.raf(time);
      requestAnimationFrame(raf);
    }

    requestAnimationFrame(raf);

    // Search Overlay Logic
    const searchOverlay = document.getElementById('search-overlay');
    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');
    const allLogCards = document.querySelectorAll('#logs .item-card');

    function toggleSearch() {
      if (searchOverlay.style.display === 'none') {
        searchOverlay.style.display = 'flex';
        searchInput.value = '';
        searchResults.innerHTML = '<div style="color:var(--ink-muted); text-align:center; padding:20px;">Type to search logs by title, category, or description...</div>';
        setTimeout(() => searchInput.focus(), 50);
      } else {
        searchOverlay.style.display = 'none';
      }
    }

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        toggleSearch();
      }
      if (e.key === 'Escape' && searchOverlay.style.display === 'flex') {
        toggleSearch();
      }
    });

    searchOverlay.addEventListener('click', (e) => {
      if (e.target === searchOverlay) toggleSearch();
    });

    searchInput.addEventListener('input', (e) => {
      const q = e.target.value.toLowerCase();
      searchResults.innerHTML = '';
      if (!q) {
        searchResults.innerHTML = '<div style="color:var(--ink-muted); text-align:center; padding:20px;">Type to search logs by title, category, or description...</div>';
        return;
      }
      
      let count = 0;
      allLogCards.forEach(card => {
        const text = card.textContent.toLowerCase();
        if (text.includes(q)) {
          const clone = card.cloneNode(true);
          // Make sure click on clone goes to the right place
          clone.addEventListener('click', () => {
             const link = clone.querySelector('.card-link');
             if(link) window.location.href = link.href;
          });
          searchResults.appendChild(clone);
          count++;
        }
      });

      if (count === 0) {
        searchResults.innerHTML = '<div style="color:var(--ink-muted); text-align:center; padding:20px;">No logs found.</div>';
      }
    });
  </script>
</body>
</html>
