<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — LearnLoop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav') %>
  <div style="max-width: 600px; margin: 60px auto; padding: 0 24px;">
    <h1>Welcome, <%= userName %> 👋</h1>
    <p style="color: var(--color-text-muted);">
      This is a placeholder dashboard — real widgets (streak, revisions, stats) come in a later phase.
    </p>
    <a href="/logs" style="display:inline-block; margin-top:16px; background:var(--color-primary); color:white; padding:9px 16px; border-radius:var(--radius); text-decoration:none; font-size:14px; font-weight:600;">
      Go to My Logs →
    </a>
  </div>
</body>
</html>
