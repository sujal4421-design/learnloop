<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — LearnLoop</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav') %>

  <div style="max-width: 860px; margin: 40px auto; padding: 0 24px;">
    <h1 style="font-size:22px; margin-bottom:4px;">Welcome back, <%= userName %> 👋</h1>
    <p style="color:var(--color-text-muted); font-size:14px; margin-bottom:28px;">
      Here's where your learning stands today.
    </p>

    <!-- Stat cards -->
    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(160px, 1fr)); gap:14px; margin-bottom:28px;">

      <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:18px;">
        <div style="font-size:12px; color:var(--color-text-muted); font-weight:600; margin-bottom:6px;">CURRENT STREAK</div>
        <div style="font-size:28px; font-weight:700;"><%= summary.currentStreak %> <span style="font-size:16px;">🔥</span></div>
        <div style="font-size:12px; color:var(--color-text-muted); margin-top:4px;">Longest: <%= summary.longestStreak %> days</div>
      </div>

      <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:18px;">
        <div style="font-size:12px; color:var(--color-text-muted); font-weight:600; margin-bottom:6px;">DUE TODAY</div>
        <div style="font-size:28px; font-weight:700;"><%= summary.dueTodayCount %></div>
        <div style="font-size:12px; color:var(--color-text-muted); margin-top:4px;">
          <a href="/revisions" style="color:var(--color-primary); text-decoration:none; font-weight:600;">Revise now →</a>
        </div>
      </div>

      <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:18px;">
        <div style="font-size:12px; color:var(--color-text-muted); font-weight:600; margin-bottom:6px;">TOTAL TOPICS LOGGED</div>
        <div style="font-size:28px; font-weight:700;"><%= summary.totalLogs %></div>
        <div style="font-size:12px; color:var(--color-text-muted); margin-top:4px;">
          <a href="/logs" style="color:var(--color-primary); text-decoration:none; font-weight:600;">View all →</a>
        </div>
      </div>

      <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:18px;">
        <div style="font-size:12px; color:var(--color-text-muted); font-weight:600; margin-bottom:6px;">REVISED VS PENDING</div>
        <div style="font-size:28px; font-weight:700;"><%= summary.revisedCount %> <span style="color:var(--color-text-muted); font-size:16px;">/ <%= summary.revisedCount + summary.pendingCount %></span></div>
        <div style="font-size:12px; color:var(--color-text-muted); margin-top:4px;"><%= summary.pendingCount %> still pending</div>
      </div>

    </div>

    <!-- Category breakdown -->
    <div style="background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:20px;">
      <div style="font-size:14px; font-weight:600; margin-bottom:14px;">Categories</div>

      <% if (summary.categoryBreakdown.length === 0) { %>
        <p style="color:var(--color-text-muted); font-size:14px; margin:0;">
          No logs yet — <a href="/logs/new" style="color:var(--color-primary); font-weight:600;">add your first one</a>.
        </p>
      <% } else { %>
        <% const maxCount = Math.max(...summary.categoryBreakdown.map(c => c.count)); %>
        <% summary.categoryBreakdown.forEach(cat => { %>
          <div style="margin-bottom:12px;">
            <div style="display:flex; justify-content:space-between; font-size:13px; margin-bottom:4px;">
              <span><%= cat.category %></span>
              <span style="color:var(--color-text-muted);"><%= cat.count %></span>
            </div>
            <div style="background:#EEF3F0; border-radius:4px; height:6px; overflow:hidden;">
              <div style="background:var(--color-primary); height:100%; width:<%= (cat.count / maxCount) * 100 %>%;"></div>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>

  </div>
</body>
</html>
